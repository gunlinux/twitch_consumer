# Copy to .env and fill in real values.
# Twitch app credentials (https://dev.twitch.tv/console/apps).
twitch_client_id=
twitch_client_secret=
# Public callback URL registered in the Twitch app console. When hosted behind
# nginx, set this to the public URL (e.g. https://x.example.com/callback) and
# proxy that path to oauth_bind_host:oauth_bind_port below.
twitch_redirect_uri=http://localhost:17563
# Where the local OAuth callback server listens. Use 0.0.0.0 only if the port
# is exposed directly (otherwise keep 127.0.0.1 behind a reverse proxy).
oauth_bind_host=127.0.0.1
oauth_bind_port=17563
# PostgreSQL (default matches the local db/ docker container; create the
# `twitch` database once: docker exec db createdb -U postgres twitch)
database_url=postgresql://postgres:example@localhost:5432/twitch
# Seconds between DB re-scans for newly authorized users.
users_resync_interval=60.0
amqp_dsn=amqp://user:password@localhost:5672
amqp_queue=messages
amqp_reconnect_delay=5.0
